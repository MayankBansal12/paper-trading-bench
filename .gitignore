node_modules/
.bun/
bun.lock

# Runtime artifacts — these ARE the benchmark output, not source.
# Everything under results/runs/ and results/reports/ is generated by
# `pnpm run run` / `pnpm run report`; only the directory markers are tracked.
results/runs/*
results/reports/*
!results/runs/.gitkeep
!results/reports/.gitkeep

# Keep the directory structure tracked via .gitkeep
!results/.gitkeep

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log

# Secrets — never commit
.env
.env.*

# Downloaded market snapshots (may include redistribution-restricted source data)
datasets/
