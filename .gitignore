node_modules/
.bun/
bun.lock

# Runtime artifacts — these ARE the benchmark output, not source.
# Local execution and report output stay untracked.
results/runs/*
results/reports/*
!results/runs/.gitkeep
!results/reports/.gitkeep

# Keep the directory structure tracked via .gitkeep
!results/.gitkeep

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log

# Secrets — never commit
.env
.env.*

# Downloaded market snapshots (may include redistribution-restricted source data)
datasets/

.sandbox/

# Model transcripts and immutable experiment artifacts
results/studies/
results/evaluations/

# Checksummed audit bundles are referenced by compact results PRs.
results/archives/

# Private clients and supervisor state
.runtime/
results/supervision/
results/qualifications/
dist/
__pycache__/
