{
  "name": "paper-trading-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Repeatable simulated portfolio and original journal environment",
  "scripts": {
    "fixtures:generate": "bun run scripts/generate-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "data:import": "bun run scripts/import-yahoo.ts",
    "model:preflight": "bun run scripts/qualify-opencode.ts",
    "study:run": "bun run scripts/run-study.ts",
    "sandbox:provision": "sh scripts/sandbox/provision.sh",
    "sandbox:check": "bun run src/index.ts sandbox-check",
    "study:control": "bun run scripts/qualify-study-control.ts",
    "bench": "bun run src/index.ts",
    "runtime:pin": "bun scripts/pin-runtime.ts",
    "runtime:check": "bun scripts/qualify-pi.ts",
    "supervise": "python3 scripts/supervise.py",
    "test:supervisor": "python3 -m unittest discover -s tests -p \"*_test.py\"",
    "viewer": "bun scripts/visualizer.ts"
  },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "pnpm@11.15.1"
}
